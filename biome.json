{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "overrides": [
    {
      "includes": ["packages/player-*/src/**", "!**/*.test.ts"],
      "plugins": ["./tools/lint/learner-text.grit"]
    },
    {
      "includes": [
        "packages/format/src/**",
        "packages/labels/src/**",
        "packages/tracking/src/**",
        "packages/player-blocks/src/**",
        "packages/exporters/src/**",
        "packages/zip/src/**",
        "packages/project/src/**",
        "packages/jobs/src/**",
        "!**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    }
  ]
}
