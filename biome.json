{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "overrides": [
    {
      "includes": ["packages/player-*/src/**", "!**/*.test.ts"],
      "plugins": ["./tools/lint/learner-text.grit"]
    },
    {
      "includes": ["packages/ui/src/**", "apps/web/src/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "error" },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@tauri-apps/**"],
                    "message": "Editor UI code reaches files, dialogs and processes only through the host interface (ADR-0006, M2-02), never through Tauri."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
