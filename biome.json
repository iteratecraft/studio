{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@tauri-apps", "@tauri-apps/**"],
                "message": "Only apps/desktop may use Tauri; editor code goes through the host interface in @course-suite/host (ADR-0006)."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/player-*/src/**", "!**/*.test.ts"],
      "plugins": ["./tools/lint/learner-text.grit"]
    },
    {
      "includes": [
        "packages/format/src/**",
        "packages/labels/src/**",
        "packages/tracking/src/**",
        "packages/player-blocks/src/**",
        "packages/exporters/src/**",
        "packages/zip/src/**",
        "packages/project/src/**",
        "packages/jobs/src/**",
        "packages/ui/src/**",
        "apps/web/src/**",
        "!**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
