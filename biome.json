{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "overrides": [
    {
      "includes": ["packages/player-*/src/**", "!**/*.test.ts"],
      "plugins": ["./tools/lint/learner-text.grit"]
    }
  ]
}
