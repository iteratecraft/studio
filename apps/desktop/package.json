{
  "name": "@course-suite/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "build:app": "cargo build --release --locked --manifest-path src-tauri/Cargo.toml",
    "check:size": "node scripts/check-size.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:installer": "tauri build --ci -- --locked"
  },
  "dependencies": {
    "@course-suite/blocks-editor": "workspace:*",
    "@course-suite/host": "workspace:*",
    "@course-suite/jobs": "workspace:*",
    "@course-suite/ui": "workspace:*",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-dialog": "2.8.2",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@course-suite/fonts": "workspace:*",
    "@course-suite/format": "workspace:*",
    "@course-suite/preview": "workspace:*",
    "@course-suite/project": "workspace:*",
    "@playwright/test": "catalog:",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "vite": "8.3.4",
    "vitest": "catalog:"
  }
}
