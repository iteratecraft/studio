{
  "productName": "Course Suite",
  "version": "../package.json",
  "identifier": "org.iteratecraft.coursesuite",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Course Suite",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self' blob: 'sha256-uPxSU/VO/1HWm6/T+D+HviZehnA75vmzgauNk/jh00E='",
        "style-src": "'self' blob:",
        "img-src": "'self' blob:",
        "font-src": "'self'",
        "frame-src": "data:",
        "connect-src": "ipc: http://ipc.localhost",
        "base-uri": "'none'",
        "form-action": "'none'",
        "object-src": "'none'"
      },
      "devCsp": {
        "default-src": "'none'",
        "script-src": "'self' blob: 'sha256-uPxSU/VO/1HWm6/T+D+HviZehnA75vmzgauNk/jh00E='",
        "style-src": "'self' 'unsafe-inline' blob:",
        "img-src": "'self' blob:",
        "font-src": "'self'",
        "frame-src": "data:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420",
        "base-uri": "'none'",
        "form-action": "'none'",
        "object-src": "'none'"
      },
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
