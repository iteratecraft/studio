{
  "rules": [
    {
      "id": "research-reference",
      "description": "Points at the private research repository or one of its paths. Build work must never depend on it.",
      "scan": "content",
      "patterns": [
        "iteratecraft[/\\\\]research\\b",
        "course-suite[/\\\\]research\\b",
        "\\.\\.[/\\\\]research\\b",
        "(?<![\\w-])research[/\\\\][\\w.-]"
      ],
      "examples": {
        "content": [
          "// git clone https://github.com/iteratecraft/research",
          "const notes = \"C:/Users/me/course-suite/research/notes.md\";",
          "import data from \"../research/evidence.json\";",
          "// see research/FINDINGS.md"
        ]
      }
    },
    {
      "id": "vendor-trademark",
      "description": "Uses a vendor trademark in code, UI text or a file name. Trademarks may appear only in docs/ and Markdown, as plain 'compatible with' statements.",
      "scan": "both",
      "patterns": ["articulate", "storyline", "rise[ _-]*360", "review[ _-]*360", "reach[ _-]*360"],
      "examples": {
        "content": [
          "export const articulateClient = {};",
          "const appName = \"Storyline\";",
          "label: 'Open in Rise 360'",
          "const REVIEW_360_URL = \"\";",
          "title=\"Reach360 learners\""
        ],
        "path": ["packages/storyline-import/src/index.ts", "apps/web/src/rise360/menu.ts"]
      }
    },
    {
      "id": "vendor-player-bundle",
      "description": "Looks like a vendor player bundle or LMS driver. Course fixtures must be packages we authored or open-source output.",
      "scan": "path",
      "patterns": ["(^|/)story_content/", "scormdriver", "(^|/)story_html5\\b"],
      "examples": {
        "path": [
          "fixtures/course/story_content/data.js",
          "fixtures/course/lms/scormdriver.js",
          "fixtures/course/story_html5.html"
        ]
      }
    }
  ],
  "allow": [
    {
      "rule": "vendor-trademark",
      "path": "^docs/",
      "reason": "Documentation may state compatibility with the vendor's products."
    },
    {
      "rule": "vendor-trademark",
      "path": "\\.md$",
      "reason": "Markdown prose may state compatibility with the vendor's products."
    },
    {
      "rule": "research-reference",
      "path": "^ARCHITECTURE\\.md$",
      "reason": "Describes where the study team records findings; it links nothing a build agent could open."
    }
  ],
  "allowText": [
    {
      "rule": "vendor-trademark",
      "pattern": "\\[[a-z0-9-]+:R\\d+\\]",
      "reason": "Spec rule tags in test titles name the spec file, for example [storyline:R5]."
    }
  ]
}
