{
  "name": "@course-suite/conformance",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "moodle:up": "node moodle/up.ts",
    "moodle:down": "docker compose -f moodle/compose.yaml down --volumes",
    "test:moodle": "playwright test -c moodle"
  },
  "dependencies": {
    "@course-suite/zip": "workspace:*",
    "@xmldom/xmldom": "catalog:",
    "playwright-core": "1.64.0",
    "scorm-again": "3.4.6"
  },
  "devDependencies": {
    "@course-suite/exporters": "workspace:*",
    "@course-suite/fonts": "workspace:*",
    "@course-suite/format": "workspace:*",
    "@course-suite/jobs": "workspace:*",
    "@course-suite/labels": "workspace:*",
    "@course-suite/player-blocks": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "rolldown": "catalog:",
    "vitest": "catalog:"
  }
}
