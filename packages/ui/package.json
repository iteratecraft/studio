  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@course-suite/format": "workspace:*",
    "@course-suite/preview": "workspace:*",
    "react": "catalog:",
    "react-aria-components": "1.22.1",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "vitest": "catalog:"
  }
}
