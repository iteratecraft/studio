{
  "$schema": "./node_modules/turbo/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "env": ["CI"],
      "passThroughEnv": ["E2E_PORT"]
    }
  },
  "boundaries": {
    "tags": {
      "format": {
        "dependencies": { "allow": [] }
      },
      "engine": {
        "dependencies": { "allow": ["format", "engine"] }
      },
      "ui": {
        "dependencies": { "allow": ["format", "engine", "ui"] }
      },
      "app": {
        "dependencies": { "allow": ["format", "engine", "ui"] }
      },
      "mit": {
        "dependencies": { "allow": ["mit"] }
      },
      "test-only": {
        "dependents": { "deny": ["ui", "app"] }
      }
    }
  }
}
